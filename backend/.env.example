# CodeLens RunFix — Environment Template. Copy to `.env`.

# ── Storage ──────────────────────────────────────────────────────────────
SQLITE_PATH=data/codelens.db

# ── Ingestion Limits ─────────────────────────────────────────────────────
CLONE_DIR=/tmp/codelens
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=300

# ── LLM Configuration ────────────────────────────────────────────────────
# Provider options: auto, groq, openrouter, ollama, anthropic
LLM_PROVIDER=auto
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
ANTHROPIC_API_KEY=
LLM_MODEL=

# ── Serving ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Public-Instance Limits ────────────────────────────────────────────────
RATE_LIMIT_ANALYSES=5
RATE_LIMIT_WINDOW_SECONDS=300
MAX_CONCURRENT_ANALYSES=2
MAX_CLONE_CACHE_MB=4000
MAX_FINISHED_JOBS=200

# ── CodeLens RunFix Sandbox & Autonomous Engine ───────────────────────────
RUNFIX_SANDBOX_TIMEOUT_SECONDS=120
RUNFIX_MAX_ITERATIONS=5
RUNFIX_MAX_MEMORY_MB=1024
GITHUB_TOKEN=
